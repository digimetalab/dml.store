# DML Store Environment Configuration
# Copy this file to .env and update with your values

# ===========================================
# DATABASE
# ===========================================
# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/dml_store

# ===========================================
# AI CONFIGURATION
# ===========================================
# OpenRouter API Key - Get yours at https://openrouter.ai/
# This is required for the AI chatbot functionality
OPENROUTER_API_KEY=sk-or-v1-your-api-key-here

# ===========================================
# WHATSAPP INTEGRATION
# ===========================================
# WhatsApp number for order redirects (without + prefix)
# Example: 628123456789 for Indonesian number
WHATSAPP_NUMBER=628123456789
